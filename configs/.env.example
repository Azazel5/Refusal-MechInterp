# Copy to .env and fill in. Never commit the real .env.
# Only needed once you move past scaffolding into actual execution.

# Hugging Face — for gated model weights (Llama 3.3 70B-Instruct is gated) and
# for pulling OR-Bench/XSTest via `datasets`.
HF_TOKEN=

# Neuronpedia — for autointerp explanations and NLA access.
NEURONPEDIA_API_KEY=

# Only needed if you choose a hosted-API path instead of local GPU weights for
# Step 0 (see src/refusal_mechinterp/models/backend.py ChatAPIBackend). Steps 1-3
# require activation access and cannot run through a hosted chat API regardless.
# CHAT_API_KEY=
# CHAT_API_BASE_URL=
